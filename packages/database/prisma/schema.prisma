generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  role              Role
  resetToken        String?
  resetTokenExpires DateTime?
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  firstName         String
  lastName          String
  preferences       Json?
  updatedAt         DateTime  @updatedAt
  venueId           Int?      @unique
  venue             Venue?    @relation(fields: [venueId], references: [id])

  @@index([createdAt])
}

model Venue {
  id             Int             @id @default(autoincrement())
  name           String
  address        String          @db.VarChar(200)
  services       String[]
  description    String?         @db.VarChar(200)
  photos         String[]
  logoURL        String?
  latitude       Float?
  longitude      Float?
  reviewsCounter Float           @default(0)
  venueRatings   Int             @default(0)
  bookings       Booking[]
  closingPeriods ClosingPeriod[]
  openingDays    OpenDays[]
  packages       Package[]
  paymentInfo    PaymentInfo?
  user           User?

  @@index([name])
}

model OpenDays {
  id       Int      @id @default(autoincrement())
  day      WeekDay
  isClosed Boolean  @default(false)
  venueId  Int
  periods  String[]
  venue    Venue    @relation(fields: [venueId], references: [id])

  @@unique([venueId, day])
  @@index([venueId])
}

model Package {
  id           Int           @id @default(autoincrement())
  description  String?       @db.VarChar(200)
  squareMetres Int?
  capacity     Int?
  services     String[]
  type         typeCoworking
  photos       String[]
  venueId      Int?
  seats        Int?
  name         String        @db.VarChar(200)
  isActive     Boolean       @default(true)
  bookings     Booking[]
  venue        Venue?        @relation(fields: [venueId], references: [id])
  plans        PackagePlan[]

  @@index([venueId])
  @@index([type])
  @@index([capacity])
}

model PackagePlan {
  id        Int       @id @default(autoincrement())
  name      String
  rate      PlansRate
  price     Decimal   @db.Decimal(10, 2)
  isEnabled Boolean   @default(false)
  packageId Int
  package   Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, name, rate])
  @@index([packageId, isEnabled])
  @@index([packageId])
  @@index([price])
}

model ClosingPeriod {
  id      Int       @id @default(autoincrement())
  start   DateTime?
  end     DateTime?
  venueId Int
  venue   Venue     @relation(fields: [venueId], references: [id])

  @@unique([venueId, start, end])
  @@index([venueId])
  @@index([venueId, start, end])
}

model PaymentInfo {
  id           Int     @id @default(autoincrement())
  companyName  String
  address      String
  iban         String? @db.VarChar(34)
  bicSwift     String  @db.VarChar(11)
  countryCode  String  @db.VarChar(3)
  currencyCode String  @db.VarChar(3)
  venueId      Int     @unique
  venue        Venue   @relation(fields: [venueId], references: [id])
}

model Booking {
  id            Int      @id @default(autoincrement())
  start         DateTime
  end           DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  venueId       Int
  packageId     Int
  reviewComfort Int      @default(0)
  reviewQuiet   Int      @default(0)
  reviewStaff   Int      @default(0)
  reviewWifi    Int      @default(0)
  people        Int      @default(1)
  status        String
  userId        Int
  costumerEmail String?
  costumerName  String
  package       Package  @relation(fields: [packageId], references: [id])
  venue         Venue    @relation(fields: [venueId], references: [id])

  @@index([venueId])
  @@index([packageId])
  @@index([start, end])
}

enum Role {
  USER
  HOST
}

enum PlansRate {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum typeCoworking {
  SALA
  DESK
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
